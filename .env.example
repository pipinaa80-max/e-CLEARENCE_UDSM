# =============================================================================
# SMARTCLEARANCE UDSM - ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Copy this file to '.env' and populate with your production or local secrets.
# NEVER commit the actual '.env' file containing real secrets to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
# For Neon PostgreSQL (Serverless / Production):
# DB_URL=jdbc:postgresql://ep-lively-poetry-bep9glo2-pooler.c-9.us-east-2.aws.neon.tech/neondb?sslmode=require&channelBinding=require
# DB_USERNAME=neondb_owner
# DB_PASSWORD=your_neon_password_here

# For Local PostgreSQL:
DB_URL=jdbc:postgresql://localhost:5432/clearance_db
DB_USERNAME=postgres
DB_PASSWORD=your_secure_db_password_here

# For MySQL (if running with --spring.profiles.active=mysql):
DB_HOST=localhost
DB_PORT=3306
DB_NAME=clearance_db

# -----------------------------------------------------------------------------
# JWT (JSON WEB TOKEN) AUTHENTICATION
# -----------------------------------------------------------------------------
# Must be at least 256 bits (32+ characters) long, cryptographically secure.
JWT_SECRET=replace_with_a_secure_random_base64_or_alphanumeric_key_min_32_chars
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# -----------------------------------------------------------------------------
# INITIAL SUPERUSER / CONTROL-PLANE ADMIN ACCOUNT
# -----------------------------------------------------------------------------
SUPERUSER_EMAIL=superuser@admin.local
SUPERUSER_PASSWORD=ChangeMeImmediately!2026

# -----------------------------------------------------------------------------
# SPRING SECURITY DEFAULT CREDENTIALS
# -----------------------------------------------------------------------------
SECURITY_USER_NAME=admin
SECURITY_USER_PASSWORD=replace_with_admin_password

# -----------------------------------------------------------------------------
# SMTP EMAIL SERVICE
# -----------------------------------------------------------------------------
# For Gmail, use an App Password (16 characters) generated under Google Account Security.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_16_char_google_app_password
MAIL_DEBUG=false

# -----------------------------------------------------------------------------
# ARIS3 INTEGRATION API
# -----------------------------------------------------------------------------
ARIS3_BASE_URL=https://aris3.udsm.ac.tz/api
ARIS3_TIMEOUT=5000
ARIS3_API_KEY=your_aris3_api_key_here

# -----------------------------------------------------------------------------
# DISTRIBUTED CACHING (REDIS / MULTI-NODE CLUSTER)
# -----------------------------------------------------------------------------
CACHE_TYPE=simple
REDIS_HOST=localhost
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# MULTI-NODE CLUSTER STORAGE (LOCAL / S3 / MINIO)
# -----------------------------------------------------------------------------
STORAGE_TYPE=local
S3_BUCKET=clearance-documents
S3_ENDPOINT=http://localhost:9000

