# =============================================================================
# UDSM e-Clearance - Backend Environment Configuration Template
# Copy this file to `.env` and populate all values for your environment.
# =============================================================================

# Runtime Mode: development | test | production
NODE_ENV=development
PORT=8080

# Reverse Proxy Trust (1 for single Nginx/Apache/ALB hop, false if exposed directly)
TRUST_PROXY=1

# -----------------------------------------------------------------------------
# Database Configuration (MySQL 8.0+ / MariaDB)
# Mandatory in production: DB_HOST, DB_USER, DB_PASSWORD, DB_NAME
# -----------------------------------------------------------------------------
DB_CLIENT=mysql2
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=clearance_db
DB_TEST_NAME=clearance_test_db
DB_CHARSET=utf8mb4
DB_POOL_MIN=2
DB_POOL_MAX=20

# -----------------------------------------------------------------------------
# Authentication & Security (MANDATORY IN PRODUCTION)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# -----------------------------------------------------------------------------
JWT_SECRET=replace-with-64-byte-hex-secret-minimum-32-characters
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# Public URLs & CORS (MANDATORY IN PRODUCTION)
# Comma-separated list of exact frontend origins allowed to call this API
# -----------------------------------------------------------------------------
FRONTEND_URL=https://clearance.jmsolutions.co.tz
CORS_ALLOWED_ORIGINS=https://clearance.jmsolutions.co.tz
CERTIFICATE_VERIFY_BASE_URL=https://api-clearance.jmsolutions.co.tz/api/v1/clearance/certificate/verify

# -----------------------------------------------------------------------------
# Uploads & Rate Limiting
# -----------------------------------------------------------------------------
# UPLOAD_DIR=/var/lib/udsm-clearance/uploads
MAX_FILE_SIZE_BYTES=10485760
RATE_LIMIT_MAX_ATTEMPTS=10

# -----------------------------------------------------------------------------
# Outbound SMTP Email Configuration (Optional; safely no-ops when SMTP_HOST is empty)
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@udsm.ac.tz
APP_NAME=SmartClearance UDSM
